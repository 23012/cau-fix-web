# 이 파일을 복사해 .env 를 만들고 실제 값을 채우세요. (.env 는 절대 커밋하지 마세요)
# cp .env.example .env

# --- Database ---
DB_NAME=facility
DB_USER=postgres
DB_PASSWORD=__CHANGE_ME__
DB_PORT=5432
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# --- App ---
NODE_ENV=production
# nginx.prod.conf 가 127.0.0.1:3000 으로 프록시하므로 3000 으로 맞춰야 함
PORT=3000
TZ=Asia/Seoul

# CORS 허용 출처 (콤마 구분). 동일 출처 서빙 시 생략 가능
# ALLOWED_ORIGINS=https://example.com

# --- Auth ---
# 충분히 긴 랜덤 값으로 생성: openssl rand -base64 32
JWT_SECRET=__CHANGE_ME__

# --- Web Push (VAPID) ---
# 생성: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=__CHANGE_ME__
VAPID_PRIVATE_KEY=__CHANGE_ME__
